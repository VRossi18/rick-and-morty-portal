# Rick and Morty Portal — copy to .env for local dev

# Polygon donation contract (required for crypto tab)
VITE_DONATION_CONTRACT_ADDRESS=

# Optional Polygon RPC override
# VITE_POLYGON_RPC_URL=https://polygon-rpc.com

# Optional WalletConnect (future)
# VITE_WALLETCONNECT_PROJECT_ID=

# --- AI curiosities (character & episode detail) — local profile (Ollama) ---

# Frontend: BFF endpoints (never put LLM_API_KEY here)
# Also enables episode curiosity (derived) and RPG chat (/api/ai/rpg-chat derived)
VITE_AI_API_URL=/api/ai/character-curiosity
# Optional override; if omitted, episode URL is derived from VITE_AI_API_URL
# VITE_AI_EPISODE_API_URL=/api/ai/episode-curiosity

# Server: read automatically by server/src/loadEnv.ts (also works from server/.env)
# Local: Ollama via Podman — see docs/llm-local.md
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama
LLM_TOOLS_ENABLED=true
LLM_TOOL_MAX_STEPS=5
ALLOWED_ORIGINS=http://localhost:5173
# SERVE_STATIC=false   # Fly default; omit locally (Vite serves the SPA)

# Production (Fly + Groq): set secrets on Fly — see docs/fly-deploy.md
# Do NOT commit .env with gsk_* keys.
# GitHub Pages build uses secret AI_API_URL → VITE_AI_API_URL at build time.

# Quick start (with AI): pnpm run llm:up && pnpm run llm:pull && pnpm run dev:all
# UI only (no AI): pnpm dev
